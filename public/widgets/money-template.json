{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "body": [
    { "type": "TextBlock", "text": "KudiLens", "weight": "Bolder", "size": "Medium" },
    { "type": "TextBlock", "text": "Safe to spend this month", "isSubtle": true, "size": "Small", "spacing": "Medium" },
    { "type": "TextBlock", "text": "${safe}", "size": "ExtraLarge", "weight": "Bolder", "spacing": "None" },
    { "type": "TextBlock", "text": "${perDay}", "isSubtle": true, "size": "Small", "wrap": true, "spacing": "None" },
    {
      "type": "ColumnSet",
      "spacing": "Medium",
      "columns": [
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Net worth", "isSubtle": true, "size": "Small" },
            { "type": "TextBlock", "text": "${netWorth}", "weight": "Bolder", "spacing": "None" }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "items": [
            { "type": "TextBlock", "text": "Debt-free", "isSubtle": true, "size": "Small" },
            { "type": "TextBlock", "text": "${debtFree}", "weight": "Bolder", "spacing": "None", "wrap": true }
          ]
        }
      ]
    },
    { "type": "TextBlock", "text": "${updated}", "isSubtle": true, "size": "Small", "wrap": true }
  ],
  "actions": [
    { "type": "Action.Execute", "title": "Open dashboard", "verb": "open" },
    { "type": "Action.Execute", "title": "Monthly check-in", "verb": "checkin" }
  ]
}
