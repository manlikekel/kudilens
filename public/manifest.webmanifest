{
  "id": "/",
  "name": "KudiLens — your private money analyst",
  "short_name": "KudiLens",
  "description": "Net worth, debts, investments and family costs in one place, with forecasts and advice built from your own numbers.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#0c111d",
  "theme_color": "#0c111d",
  "categories": ["finance", "productivity"],
  "prefer_related_applications": false,
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/icons/icon.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "screenshots": [
    {
      "src": "/screenshots/phone-dashboard.jpg",
      "sizes": "657x1421",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Your net worth, what to do next and what's safe to spend, with amounts hidden in privacy mode"
    },
    {
      "src": "/screenshots/phone-funds.jpg",
      "sizes": "657x1421",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Compare yields on every SEC-registered Nigerian fund, updated weekly"
    },
    {
      "src": "/screenshots/phone-invest.jpg",
      "sizes": "657x1421",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "Find regulated places to invest in Nigeria, the US, the UK and Canada"
    },
    {
      "src": "/screenshots/phone-guide.jpg",
      "sizes": "657x1421",
      "type": "image/jpeg",
      "form_factor": "narrow",
      "label": "A plain-English guide to every part of the app"
    }
  ],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        {
          "name": "statement",
          "accept": ["text/csv", ".csv", "text/plain", ".txt", "application/pdf", ".pdf"]
        }
      ]
    }
  },
  "widgets": [
    {
      "name": "KudiLens: My money",
      "short_name": "My money",
      "description": "Safe to spend this month, net worth and your debt-free date. Amounts stay hidden when privacy mode is on.",
      "tag": "money",
      "template": "money",
      "ms_ac_template": "/widgets/money-template.json",
      "data": "/widgets/money-data.json",
      "type": "application/json",
      "auth": false,
      "update": 3600,
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }],
      "screenshots": [
        {
          "src": "/screenshots/phone-dashboard.jpg",
          "sizes": "657x1421",
          "label": "Your money at a glance"
        }
      ]
    },
    {
      "name": "KudiLens: Market today",
      "short_name": "Market today",
      "description": "Nigerian inflation, the dollar rate and the best money market fund yield, updated daily.",
      "tag": "market",
      "template": "market",
      "ms_ac_template": "/widgets/market-template.json",
      "data": "/api/widget-market",
      "type": "application/json",
      "auth": false,
      "update": 21600,
      "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }],
      "screenshots": [
        {
          "src": "/screenshots/phone-funds.jpg",
          "sizes": "657x1421",
          "label": "Live fund yields and market figures"
        }
      ]
    }
  ],
  "shortcuts": [
    { "name": "Plan", "short_name": "Plan", "url": "/plan", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Spending", "short_name": "Spending", "url": "/spending", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Ask Kudi", "short_name": "Ask Kudi", "url": "/advisor", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "My numbers", "short_name": "My numbers", "url": "/records", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
